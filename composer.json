{
    "name": "andydefer/directive-forge",
    "description": "Code generation directives for Laravel - forge directives, actions, tasks, repositories, records and typed collections etc...",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andy Defer",
            "email": "andykanidimbu@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^12.0|^13.0|^14.0|^15.0",
        "andydefer/laravel-directive": "^3.56.6"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "composer/composer": "^2.0",
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.8",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "*",
        "symfony/var-dumper": "^7.0",
        "vimeo/psalm": "^6.14"
    },
    "autoload": {
        "psr-4": {
            "AndyDefer\\DirectiveForge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndyDefer\\DirectiveForge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AndyDefer\\DirectiveForge\\DirectiveForgeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "composer/package-versions-deprecated": true
        }
    }
}
