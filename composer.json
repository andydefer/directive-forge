{
    "name": "andydefer/directive-forge",
    "description": "Code generation directives for Laravel - forge directives, actions, tasks, repositories, records and typed collections etc...",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andy Defer",
            "email": "andykanidimbu@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^12.0|^13.0|^14.0|^15.0",
        "andydefer/laravel-directive": "^2.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "AndyDefer\\DirectiveForge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndyDefer\\DirectiveForge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AndyDefer\\DirectiveForge\\DirectiveForgeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
